{
  "name": "docs",
  "version": "0.1.0",
  "description": "A desktop word processor that treats .docx as its own format, preserving everything it does not model.",
  "license": "MIT",
  "author": "Dmytro Hutsuliak <dmytro.hutsuliak.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HutsuliakDmytro/orangery.git",
    "directory": "apps/docs"
  },
  "homepage": "https://github.com/HutsuliakDmytro/orangery/tree/main/apps/docs#readme",
  "bugs": {
    "url": "https://github.com/HutsuliakDmytro/orangery/issues"
  },
  "keywords": [
    "docx",
    "ooxml",
    "word-processor",
    "editor",
    "tauri",
    "prosemirror"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --force && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b --force",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:render": "vite-node scripts/render-diff.ts --",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-character-count": "^2.27.3",
    "@tiptap/extension-color": "^2.27.3",
    "@tiptap/extension-font-family": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-subscript": "^2.27.3",
    "@tiptap/extension-superscript": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.1",
    "i18next": "^26.4.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.46.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.14",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
