{
  "name": "sheets",
  "version": "0.1.0",
  "description": "A desktop spreadsheet that treats .xlsx as its own format.",
  "license": "MIT",
  "author": "Dmytro Hutsuliak <dmytro.hutsuliak.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HutsuliakDmytro/orangery.git",
    "directory": "apps/sheets"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --force && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b --force",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:speed": "MEASURE_SPEED=1 vitest run src/test/performance.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icon": "tauri icon src-tauri/icons/icon.svg"
  },
  "dependencies": {
    "@orangery/charts": "workspace:*",
    "@orangery/fonts": "workspace:*",
    "@orangery/grid": "workspace:*",
    "@orangery/numfmt": "workspace:*",
    "@orangery/ooxml-core": "workspace:*",
    "@orangery/ooxml-drawingml": "workspace:*",
    "@orangery/ooxml-spreadsheet": "workspace:*",
    "@orangery/platform": "workspace:*",
    "@orangery/ui-kit": "workspace:*",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "lucide-react": "^1.46.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@orangery/render-diff": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/cli": "^2.9.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
