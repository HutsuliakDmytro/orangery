{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orangery Slides",
  "version": "0.1.0",
  "identifier": "com.orangery.slides",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orangery Slides",
        "width": 1280,
        "height": 840,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "entitlements": null
    },
    "category": "Productivity",
    "shortDescription": "Presentation editor that writes real PPTX",
    "longDescription": "Orangery Slides is a desktop presentation editor that uses PPTX as its native format.",
    "copyright": "© Dmytro Hutsuliak",
    "publisher": "Dmytro Hutsuliak",
    "fileAssociations": [
      {
        "ext": ["pptx"],
        "name": "PowerPoint Presentation",
        "description": "Microsoft PowerPoint Presentation",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      }
    ]
  }
}
