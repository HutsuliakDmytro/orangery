{
  "name": "orangery",
  "private": true,
  "type": "module",
  "description": "Orangery — an office suite with OOXML as its native format.",
  "license": "MIT",
  "author": "Dmytro Hutsuliak <dmytro.hutsuliak.dev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HutsuliakDmytro/orangery.git"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "check": "pnpm format:check && pnpm -r check",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "pnpm -r test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "corpus:inventory": "vite-node scripts/corpus/inventory.ts --",
    "corpus:select": "vite-node scripts/corpus/select.ts --",
    "corpus:run": "vite-node scripts/corpus/run.ts --",
    "corpus:recalc": "vite-node scripts/corpus/recalc.ts --",
    "corpus:render": "vite-node scripts/corpus/render.ts --",
    "corpus:charts": "vite-node scripts/corpus/charts-svg.ts --",
    "corpus:formats": "vite-node scripts/corpus/number-formats.ts --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@orangery/ooxml-core": "workspace:*",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jszip": "^3.10.2",
    "prettier": "^3.9.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.0",
    "vite-node": "^6.0.0"
  }
}
